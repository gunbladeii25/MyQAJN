# Copy to .env and fill in real values. Never commit .env itself.
POSTGRES_PASSWORD=change_me
FRONTEND_URL=http://localhost:5173
# External production DB (Postgres) the backend connects to for real
# user/case data. Format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=<schema>
EXTERNAL_DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# Google Sign-In — baked into the frontend bundle at `docker compose build`
# time (see frontend/Dockerfile ARGs). Same client ID as backend/.env's
# GOOGLE_CLIENT_ID. Leave blank to build without the Google login button.
VITE_GOOGLE_CLIENT_ID=
# Where the pegawai_nazir-only "Detector@JN" nav link opens.
VITE_DETECTOR_JN_URL=https://app.8.233.60.191.nip.io
