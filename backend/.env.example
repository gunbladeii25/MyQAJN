DATABASE_URL="postgresql://prestij_admin:prestij_secret@localhost:5432/G6_P23"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
AI_ENGINE_URL="http://localhost:8010"
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Sign-In — separate OAuth 2.0 Web Client ID scoped to myqajn's own
# origins (do NOT reuse Detector@JN's client ID, keeps the two systems
# decoupled). Create via GCP Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=moe.gov.my,moe-dl.edu.my

# Detector@JN SSO handoff — lets a logged-in pegawai_nazir/admin open
# Detector@JN without seeing its own login screen. SSO_HANDOFF_SECRET must
# match the SAME value configured in Detector@JN's auth-service (a secret
# dedicated to this handoff only — NOT either system's JWT_SECRET). Generate
# with: openssl rand -hex 32
SSO_HANDOFF_SECRET=
DETECTOR_JN_URL=https://app.8.233.60.191.nip.io

# SMTP — leave blank to run in log-only mode (dev/demo, no real email sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MyQA@JN <no-reply@myqajn.my>
