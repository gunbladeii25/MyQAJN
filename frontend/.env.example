# Copy to .env for local dev. Vite only exposes vars prefixed VITE_ to the
# browser bundle — these are baked in at BUILD time, not read at runtime.

# Same OAuth 2.0 Web Client ID as backend/.env's GOOGLE_CLIENT_ID (public,
# not a secret — it's sent to the browser). Leave blank to hide the
# "Sign in with Google" button entirely (LoginPage.jsx checks for it).
VITE_GOOGLE_CLIENT_ID=

# Where the "Detector@JN" nav link (pegawai_nazir role) opens. Defaults to
# the current production host if left unset — see DetectorJnPage.jsx.
VITE_DETECTOR_JN_URL=https://app.8.233.60.191.nip.io
